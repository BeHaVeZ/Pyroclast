# ============================================================
# Pyroclast .gitignore
# C++20 / CMake / SDL3 / D3D12 / Vulkan
# ============================================================


# ------------------------------------------------------------
# CMake
# ------------------------------------------------------------
/build/
/build-*/
/out/
/cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
Testing/
Makefile
compile_commands.json
CMakeUserPresets.json

# Keep shared project presets if added later.
# CMakePresets.json is intentionally NOT ignored.

# ------------------------------------------------------------
# Visual Studio
# ------------------------------------------------------------
.vs/
*.sln.docstates
*.suo
*.user
*.userosscache
*.sln.cache

# Visual Studio generated build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
ARM/
ARM64/

# ------------------------------------------------------------
# VS Code / JetBrains
# ------------------------------------------------------------
.vscode/
.idea/
*.code-workspace

# ------------------------------------------------------------
# Compiler / linker output
# ------------------------------------------------------------
*.obj
*.o
*.lo
*.slo
*.pch
*.pdb
*.idb
*.ilk
*.exp
*.lib
*.a
*.la
*.lai
*.dll
*.so
*.so.*
*.dylib
*.exe
*.out
*.app

# ------------------------------------------------------------
# Runtime / debug output
# ------------------------------------------------------------
*.log
logs/
crashdumps/
*.dmp

# ------------------------------------------------------------
# Generated shader output
# Source HLSL should remain tracked.
# ------------------------------------------------------------
/generated/
/shaders/generated/
*.dxil
*.spv
*.cso

# ------------------------------------------------------------
# Profiling / capture output
# ------------------------------------------------------------
/captures/
/profiles/
/benchmarks/results/
*.wpix
*.rdc
*.nsys-rep
*.nvvp

# ------------------------------------------------------------
# Package / dependency caches
# ------------------------------------------------------------
/.cache/
/packages/
.nuget/

/docs/
**/AGENTS.md
**/AGENT.md
**/AI.md
**/*.ai.md
**/*.agent.md
/.ai/
/.agents/
/.codex/

**/CLAUDE.md
**/GEMINI.md

# If dependencies are fetched/generated by CMake, keep their build
# products out of source control.
/_deps/

# ------------------------------------------------------------
# OS files
# ------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# ------------------------------------------------------------
# Temporary / backup files
# ------------------------------------------------------------
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
