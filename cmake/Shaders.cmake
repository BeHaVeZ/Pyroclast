find_program(PYROCLAST_DXC NAMES dxc
    HINTS
        "$ENV{VULKAN_SDK}/Bin"
        "$ENV{WindowsSdkDir}/bin/${CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION}/x64"
        "$ENV{ProgramFiles\(x86\)}/Windows Kits/10/bin/${CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION}/x64"
    DOC "Path to DXC with both DXIL and SPIR-V support"
)
if(NOT PYROCLAST_DXC)
    message(FATAL_ERROR "DXC was not found. Download Microsoft's standalone DXC release and set PYROCLAST_DXC to its bin/x64/dxc.exe.")
endif()
message(STATUS "Pyroclast DXC: ${PYROCLAST_DXC}")

# Windows SDK builds can advertise -spirv without including its code generator.
set(shader_probe_dir "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/shader-probe")
file(MAKE_DIRECTORY "${shader_probe_dir}")
file(WRITE "${shader_probe_dir}/probe.hlsl"
    "float4 main(uint id : SV_VertexID) : SV_Position { return float4(0, 0, 0, 1); }\n")
execute_process(
    COMMAND "${PYROCLAST_DXC}" -spirv -fspv-target-env=vulkan1.1
        -T vs_6_0 -E main -Fo "${shader_probe_dir}/probe.spv" "${shader_probe_dir}/probe.hlsl"
    RESULT_VARIABLE shader_probe_result
    OUTPUT_VARIABLE shader_probe_output
    ERROR_VARIABLE shader_probe_error
    TIMEOUT 30
)
if(NOT shader_probe_result STREQUAL "0")
    message(FATAL_ERROR
        "DXC cannot compile SPIR-V. Download Microsoft's standalone DXC release from\n"
        "https://github.com/microsoft/DirectXShaderCompiler/releases and set\n"
        "PYROCLAST_DXC to its bin/x64/dxc.exe (keep the supplied DLLs beside it).\n"
        "${shader_probe_output}${shader_probe_error}")
endif()

# Every embedded shader, one per line: <Shader enumerator>:<file in shaders/ without .hlsl>:<stage>:<entry point>.
# This list is the only place a shader is registered: it generates the Shader enum and both backends' tables.
set(PYROCLAST_SHADERS
    particle_vertex:particles:vs:vs_main
    particle_pixel:particles:ps:ps_main
    particle_lod_vertex:particles_lod:vs:vs_lod
    particle_simulation:particles_compute:cs:cs_main
    particle_scan:particle_scan:cs:cs_main
    particle_scatter:particle_scatter:cs:cs_main
    particle_scatter_measure:particle_scatter:cs:cs_measure
    debris_vertex:debris:vs:vs_main
    debris_pixel:debris:ps:ps_main
    composite_vertex:composite:vs:vs_main
    composite_pixel:composite:ps:ps_main
    terrain_vertex:terrain:vs:vs_main
    terrain_pixel:terrain:ps:ps_main
    sky_vertex:sky:vs:vs_main
    sky_pixel:sky:ps:ps_main
    tonemap_vertex:tonemap:vs:vs_main
    tonemap_pixel:tonemap:ps:ps_main
    debug_lines_vertex:debug_lines:vs:vs_main
    debug_lines_pixel:debug_lines:ps:ps_main
    props_vertex:props:vs:vs_main
    props_pixel:props:ps:ps_main
    collider_lines_vertex:collider_lines:vs:vs_main
    showcase_lines_vertex:showcase_lines:vs:vs_main
    particle_realism_simulation:particles_compute_realism:cs:cs_realism
    particle_scan_units:particle_scan_units:cs:cs_main
    particle_scatter_units:particle_scatter_units:cs:cs_main
    particle_scatter_units_measure:particle_scatter_units:cs:cs_measure
    particle_realism_vertex:particles_realism:vs:vs_realism
    particle_realism_lod_vertex:particles_realism_lod:vs:vs_realism_lod
)

# Vulkan bindings come from the shared binding layout, so C++ (binding_layout.hpp) and SPIR-V agree.
set(binding_layout "${CMAKE_CURRENT_SOURCE_DIR}/shaders/binding_layout.hlsli")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${binding_layout}")
file(STRINGS "${binding_layout}" binding_shift_lines REGEX "vulkan_[btus]_shift = [0-9]+;")
set(vulkan_binding_shifts "")
foreach(line IN LISTS binding_shift_lines)
    string(REGEX MATCH "vulkan_([btus])_shift = ([0-9]+);" matched "${line}")
    list(APPEND vulkan_binding_shifts "-fvk-${CMAKE_MATCH_1}-shift" "${CMAKE_MATCH_2}" "0")
endforeach()
list(LENGTH vulkan_binding_shifts binding_shift_words)
if(NOT binding_shift_words EQUAL 12)
    message(FATAL_ERROR "shaders/binding_layout.hlsli must define vulkan_b/t/u/s_shift.")
endif()

set(shader_generated_dir "${CMAKE_CURRENT_BINARY_DIR}/generated/shaders")
set(shader_list "// Generated by cmake/Shaders.cmake from PYROCLAST_SHADERS; do not edit.\n")
set(d3d12_shader_includes "${shader_list}")
set(vulkan_shader_includes "${shader_list}")
foreach(shader IN LISTS PYROCLAST_SHADERS)
    string(REPLACE ":" ";" fields "${shader}")
    list(GET fields 0 name)
    list(GET fields 1 source)
    list(GET fields 2 stage)
    list(GET fields 3 entry)
    string(APPEND shader_list "PYROCLAST_SHADER(${name}, \"${entry}\")\n")
    foreach(backend IN ITEMS d3d12 vulkan)
        string(APPEND ${backend}_shader_includes "#include \"${backend}/${name}.hpp\"\n")
        set(shader_output_dir "${shader_generated_dir}/$<CONFIG>/${backend}")
        if(backend STREQUAL "d3d12")
            set(shader_extension dxil)
            set(shader_options "$<$<CONFIG:Debug>:-Qembed_debug>")
        else()
            set(shader_extension spv)
            set(shader_options -spirv -fspv-target-env=vulkan1.1 ${vulkan_binding_shifts})
        endif()
        set(shader_header "${shader_output_dir}/${name}.hpp")
        set(shader_binary "${shader_output_dir}/${name}.${shader_extension}")
        set(shader_depfile "${shader_output_dir}/${name}.d")
        add_custom_command(
            OUTPUT "${shader_header}" "${shader_binary}"
            COMMAND ${CMAKE_COMMAND} -E make_directory "${shader_output_dir}"
            COMMAND "${PYROCLAST_DXC}"
                -T "${stage}_6_0" -E "${entry}" -HV 2021 -Ges -WX
                -fdiagnostics-format=msvc
                "$<IF:$<CONFIG:Debug>,-Od,-O3>" "$<$<CONFIG:Debug>:-Zi>"
                ${shader_options}
                -Fo "${shader_binary}" -Fh "${shader_header}" -Vn "${name}"
                "${CMAKE_CURRENT_SOURCE_DIR}/shaders/${source}.hlsl"
            # DXC's combined -MD/SPIR-V path crashes; preprocessing separately works.
            COMMAND "${PYROCLAST_DXC}" -T "${stage}_6_0" -E "${entry}" -HV 2021
                -M -MF "${shader_depfile}" -Fo "${shader_binary}"
                "${CMAKE_CURRENT_SOURCE_DIR}/shaders/${source}.hlsl"
            DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/shaders/${source}.hlsl" "${PYROCLAST_DXC}"
            DEPFILE "${shader_depfile}"
            COMMENT "Compiling ${name} (${source}.hlsl ${entry}) for ${backend}"
            COMMAND_EXPAND_LISTS
            VERBATIM
        )
        target_sources(Pyroclast PRIVATE "${shader_header}" "${shader_binary}")
    endforeach()
endforeach()

# Written only when the list changes, so editing a shader source does not touch these.
file(CONFIGURE OUTPUT "${shader_generated_dir}/shader_list.inl" CONTENT "${shader_list}" @ONLY)
file(CONFIGURE OUTPUT "${shader_generated_dir}/d3d12_shaders.inl" CONTENT "${d3d12_shader_includes}" @ONLY)
file(CONFIGURE OUTPUT "${shader_generated_dir}/vulkan_shaders.inl" CONTENT "${vulkan_shader_includes}" @ONLY)

# The Shader enum comes from shader_list.inl, so everything that names a Shader needs this directory.
add_library(pyroclast_shader_list INTERFACE)
target_include_directories(pyroclast_shader_list INTERFACE "${shader_generated_dir}")
target_link_libraries(Pyroclast PRIVATE pyroclast_shader_list)
# Backend sources include "<backend>/<name>.hpp"; the directory selects the configuration.
target_include_directories(Pyroclast PRIVATE "${shader_generated_dir}/$<CONFIG>")
